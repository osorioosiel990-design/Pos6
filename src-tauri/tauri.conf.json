{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Ferretería Suárez",
  "version": "1.0.0",
  "identifier": "com.ferreteriapro.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FerreteríaPRO",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "copyright": "Copyright © 2024",
    "icon": [
      "icons/icon.ico"
    ],
    "longDescription": "Sistema de Gestión de Ferretería - Control de inventario, ventas, compras y métricas",
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
